# Data — never commit raw/processed data or annotated frames, they belong in Kaggle Datasets
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.mp4
data/**/*.avi
data/**/*.npy
data/**/*.npz
data/**/*.mat
data/**/*.h5
!data/**/.gitkeep

# Checkpoints — large binary, belongs in Kaggle Datasets, not git
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.ckpt
!checkpoints/.gitkeep

# Outputs — regenerable, not source of truth
outputs/experiments/**/*.png
outputs/experiments/**/*.jpg
outputs/experiments/**/*.csv
outputs/indicators/**/*.npy
outputs/indicators/**/*.csv
!outputs/**/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
.vscode/
*.swp

# Kaggle credentials — NEVER commit
kaggle.json
